<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

class Loan extends Model
{
    //
    protected $fillable = [
    'borrower_id',   // Bukan user_id
    'tool_id',
    'approved_by',   // Bukan admin_id
    'approver_type', // Untuk simpan class Admin atau Officer
    'date_loan',
    'penalty',
    'return_date',
    'status',
];

// Relasi ke Peminjam
public function borrower() {
    return $this->belongsTo(Borrower::class, 'borrower_id'); 
}

// Relasi Polymorphic untuk yang approve (Bisa Admin atau Officer)
public function approver() {
    return $this->morphTo('approver', 'approver_type', 'approved_by');
}

public function Tool() {
    return $this->belongsTo(tool::class, 'tool_id');
}
}
