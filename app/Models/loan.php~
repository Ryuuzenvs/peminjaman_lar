<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;

class loan extends Model
{
    //
    protected $fillable = [
    'user_id'.
    'tool_id',
'admin_id',
'date_loan',
'penalty',
'return_date',
'status',
    ];
}

public function user {
return $this->belongsTo(user::class);
}

public function tool {
return $this->belongsTo(tool::class);
}
