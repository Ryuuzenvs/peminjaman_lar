<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

class UserController extends Controller
{
    private function getModel($role)
{
    return match ($role) {
        'admin' => \App\Models\Admin::class,
        'officer' => \App\Models\Officer::class,
        'borrower' => \App\Models\Borrower::class,
        default => abort(404, "Role tidak valid"),
    };
}
    /**
     * Display a listing of the resource.
     */
    public function index()
    {
        //
    $users = collect([
    ...\App\Models\Admin::all()->map(function($admin) {
        return (object) array_merge(['role' => 'admin'] + $admin->toArray());
    }),
    ...\App\Models\Borrower::all()->map(function($borrower) {
        return (object) array_merge(['role' => 'borrower'] + $borrower->toArray());
    }),
    ...\App\Models\Officer::all()->map(function($officer) {
        return (object) array_merge(['role' => 'officer'] + $officer->toArray());
    }),
]);
    return view('admin.users.index', compact('users'));
    }

    /**
     * Show the form for creating a new resource.
     */
    public function create()
    {
        //
return view('admin.users.create');
    }

    /**
     * Store a newly created resource in storage.
     */
public function store(Request $request)
{
    $data = $request->validate([
        'username' => 'required',
        'password' => 'required|min:6',
        'role' => 'required'
    ]);

    $data['password'] = bcrypt($request->password); 
    

    $modelName = $this->getModel($request->role);
    $modelName::create($data);

    return redirect()->route('users.index')->with('success', 'User berhasil ditambahkan');
}

    /**
     * Display the specified resource.
     */
    public function show(string $id)
    {
        //
    }

    /**
     * Show the form for editing the specified resource.
     */
    // ... (index & create tetap sama)

public function edit($id, Request $request)
{
    // Ambil role dari query string (?role=admin)
    $role = $request->query('role');
    
    if (!$role) {
        return back()->with('error', 'Parameter role diperlukan');
    }

    $modelName = $this->getModel($role);
    $user = $modelName::findOrFail($id);
    
    return view('admin.users.edit', compact('user', 'role'));
}

public function update(Request $request, $id)
{
    $role = $request->role; // Pastikan di form edit ada <input type="hidden" name="role" value="{{ $role }}">
    $modelName = $this->getModel($role);
    $user = $modelName::findOrFail($id);

    $data = $request->validate([
        'username' => 'required',
        'email' => 'required|unique:' . (new $modelName)->getTable() . ',email,' . $id,
    ]);

    if ($request->filled('password')) {
        $data['password'] = bcrypt($request->password);
    }

    $user->update($data);
    return redirect()->route('users.index')->with('success', 'User berhasil diupdate');
}

public function destroy(Request $request, $id)
    {
    $role = $request->query('role'); 
    $modelName = $this->getModel($role);
    
    // Proteksi sederhana agar tidak hapus diri sendiri (jika admin)
    if ($role === 'admin' && $id == auth()->id()) {
        return back()->with('error', 'Tidak bisa menghapus akun sendiri');
    }

    $modelName::destroy($id);
    return back()->with('success', 'User berhasil dihapus');
    }
}
