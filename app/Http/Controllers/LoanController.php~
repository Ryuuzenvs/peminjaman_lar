public function update(Request $request, $id)
{

    $loan = loan::findOrFail($id);
$user = Auth::user() 
            ?? auth()->guard('admin')->user() 
            ?? auth()->guard('officer')->user();
if (!$user) return redirect()->route('login')->with('error', 'Login dulu bro!');

    if ($request->has('action') && $request->action == 'return') {
    return $this->returnTool($id, $user);
    }

$data = $request->all();

$data['approved_by'] = $user->id;
$data['approver_type'] = get_class($user);
$loan->update($data);
    return redirect()->route('admin.loans.index')->with('success', 'Data peminjaman diperbarui.');
    }

